# Скопируйте в .env и заполните. НИКОГДА не коммитьте .env.
SECRET_KEY=change-me-to-64-random-chars
DEBUG=0
ALLOWED_HOSTS=crm.example.by,localhost
CORS_ORIGINS=https://crm.example.by

# PostgreSQL (в docker-compose поднимается сервисом db)
DB_NAME=crm
DB_USER=crm
DB_PASSWORD=strong-password
DB_HOST=db
DB_PORT=5432

# Fernet-ключ для шифрования перс. данных преподавателей:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# bePaid (боевые ключи — только на prod; пусто = интеграция выключена)
BEPAID_SHOP_ID=
BEPAID_SECRET_KEY=
BEPAID_WEBHOOK_IPS=
BEPAID_SERVICE_NUMBER=
